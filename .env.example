# KAGURA environment template
# Copy to .env.local for local development. NEVER commit real secrets.

# App
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_SECRET=

# Database (PostgreSQL) - optional/future; MVP uses local JSON persistence in data/ (gitignored)
# DATABASE_URL=postgresql://user:password@localhost:5432/kagura

# GitHub observation (OBSERVE) - REQUIRED for real GitHub API observation
# Create a GitHub Personal Access Token (classic) with at least `repo` scope for private repos
# or `public_repo` scope for public repos: https://github.com/settings/tokens
# Keep this token server-side only (never expose to client, never commit). Set in .env.local.
GITHUB_TOKEN=
# Repository to observe (defaults used by app if unset: owner Web3banji, name kagura-agent)
GITHUB_REPO_OWNER=Web3banji
GITHUB_REPO_NAME=kagura-agent
# Optional: full slug override (owner/name). If set, takes precedence over OWNER/NAME.
# GITHUB_REPO=Web3banji/kagura-agent

# AI provider (WRITE - optional/future; MVP generates drafts from templates + evidence)
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=

# GitHub OAuth (user sign-in, identity) - Milestone 1
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAuth token storage encryption (Milestone 1.5) - REQUIRED for writing new OAuth tokens
# Provide a 32-byte key encoded as base64/base64url or hex (64 chars). Server-side only; never commit real keys.
# KAGURA_TOKEN_ENCRYPTION_KEY=
# Optional: previous key(s) for decryption/key rotation (comma or newline separated, same format)
# KAGURA_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Kane / verification (VERIFY)
# Vercel is the coordinator; Kane CLI runs ONLY on a shared authenticated local Windows runner.
# KAGURA_APP_URL is the real running app URL Kane verifies (must be accessible to the runner).
KAGURA_APP_URL=http://localhost:3000
# Shared runner -> app authentication (server-side only, NEVER expose to clients/browser)
# KAGURA_RUNNER_TOKEN=
# KANE_CLI_USER_AGENT=kilocode
# KANE_BROWSER_PROFILE= (runner uses a per-job profile under data/verification/profiles by default)

# Runner job isolation / hardening (scripts/kane-runner.mjs)
# Absolute path to the kane-cli Node entry point (kane-cli.cjs). Used to spawn Kane with node.exe
# instead of routing through cmd.exe. Leave unset to auto-detect from node_modules / npm global root.
# KAGURA_KANE_CLI_JS=
# POSIX only: kane-cli executable name or path when KAGURA_KANE_CLI_JS is not applicable.
# KAGURA_KANE_CLI_BIN=kane-cli
# Comma-separated extra env var NAMES to pass to job processes (secrets are always filtered out).
# KAGURA_KANE_CHILD_ENV_EXTRA=
# Days to retain old per-job workspaces before pruning. 0 (default) disables pruning so evidence
# is never silently deleted.
# KAGURA_RUNNER_WORKSPACE_RETENTION_DAYS=0

# Admin (dashboard/API protection when set)
# KAGURA_ADMIN_TOKEN=


