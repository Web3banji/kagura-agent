# ECHOLOG environment template
# Copy to .env.local for local development. NEVER commit real secrets.

# App
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_SECRET=

# Database (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/echolog

# GitHub (repository observation) - use least-privilege token/app credentials
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# AI provider (configure the provider used by the app)
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=

# Kane / verification (local runner must be authenticated separately via `kane-cli login`)
# KANE_CLI_USER_AGENT=kilocode
# KANE_BROWSER_PROFILE=
# KANE_START_URL=http://localhost:3000
