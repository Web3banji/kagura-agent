{
  "name": "kagura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "kane:verify": "node scripts/kane-verify.mjs",
    "kane:runner": "node scripts/kane-runner.mjs",
    "test:runner": "node scripts/test-runner-workspace.mjs && node scripts/test-runner-security.mjs && npx tsx scripts/test-runner-adversarial.ts",
    "test:multiuser": "npx tsx scripts/test-multiuser-regression.ts",
    "test": "npm run test:runner && npm run test:multiuser",
    "checks": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "next": "14.2.35",
    "pg": "^8.23.1",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
